generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String          @id @default(cuid())
  companyName    String
  ownerName      String?
  identifier     String          @unique // No. HP / Username / Email untuk login
  address        String?
  phone          String?
  npwp           String?
  pinHash        String
  recoveryKey    String          @default("sim2026")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  purchaseOrders PurchaseOrder[]
  cashInflows    CashInflow[]

  @@index([identifier])
}

model PurchaseOrder {
  id              String       @id @default(cuid())
  poNumber        String
  date            DateTime
  supplierName    String
  status          String       @default("OUTSTANDING") // OUTSTANDING, PARTIAL, CLOSED
  totalCost       Float        @default(0)
  expectedRevenue Float        @default(0)
  proofFileUrl    String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenantId        String?
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items      OrderItem[]
  cashInflow CashInflow[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@index([supplierName])
}

model OrderItem {
  id        String         @id @default(cuid())
  poId      String
  po        PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemName  String
  qty       Float          @default(1)
  unit      String
  unitPrice Float
  subtotal  Float          @default(0)

  @@index([poId])
}

model CashInflow {
  id             String         @id @default(cuid())
  poId           String
  po             PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  amount         Float
  receivedDate   DateTime
  paymentMethod  String         // TRANSFER_BANK, TUNAI
  proofFileUrl   String?
  notes          String?
  createdAt      DateTime       @default(now())

  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([poId])
  @@index([receivedDate])
}

model SecurityConfig {
  id             String   @id @default("default")
  pinHash        String
  recoveryKey    String   @default("sim2026")
  isInitialized  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}